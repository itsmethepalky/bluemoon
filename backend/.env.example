# public URL and anon key, the same ones the frontend uses).
SUPABASE_URL=https://fulnozrxrucvmvhwfipe.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZ1bG5venJ4cnVjdm12aHdmaXBlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODk3NDY4MTQsImV4cCI6MjEwNTMyMjgxNH0.JtKBHVOITH44aLgpCVVAT5APe6HG3gnHG26ZuRMHYko

# SECRET - get this from Dashboard > Project Settings > API > "service_role"
# key (click reveal). Never commit this or send it to the frontend - it
# bypasses Row Level Security and can manage every user account.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET - the direct Postgres connection string. Get it from Dashboard >
# Project Settings > Database > "Connection string" > URI tab (choose
# "Transaction pooler" for most deployments). Paste it below and swap the
# "postgresql://" prefix for "postgresql+psycopg2://", and fill in the
# database password you set when the project was created (or reset it from
# that same Database settings page if you don't have it).
#   postgresql+psycopg2://postgres.fulnozrxrucvmvhwfipe:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

